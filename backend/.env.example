DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/annachakra
SECRET_KEY=replace-with-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relative policy paths resolve from the backend directory.
APP_ENV=development
# The simulated policy is only allowed with APP_ENV=demo or APP_ENV=test.
